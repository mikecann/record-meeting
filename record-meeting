#!/usr/bin/env bash

set -euo pipefail

# install.sh puts a symlink on PATH. Find the clone before dispatching to scripts.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  LINK_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$LINK_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
APP_DIR="${RECORD_MEETING_APP_DIR:-$HOME/Applications/Record Meeting.app}"

case "${1:-start}" in
  start)
    if [[ ! -d "$APP_DIR" ]]; then
      bash "$SCRIPT_DIR/setup_mac.sh"
    fi
    open "$APP_DIR"
    ;;
  restart)
    exec bash "$SCRIPT_DIR/restart.sh"
    ;;
  stop|kill)
    exec bash "$SCRIPT_DIR/kill.sh"
    ;;
  setup|install)
    exec bash "$SCRIPT_DIR/setup_mac.sh"
    ;;
  *)
    echo "Usage: record-meeting [start|restart|stop|setup]" >&2
    exit 2
    ;;
esac
